<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- HTTP surface: controllers, error mapping, composition root. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The API contract is served at /openapi/v1.yaml for Swagger UI in Development. -->
    <None Include="..\..\docs\api\openapi.v1.yaml" Link="openapi.v1.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdvisorFlow.Application\AdvisorFlow.Application.csproj" />
    <ProjectReference Include="..\AdvisorFlow.Infrastructure\AdvisorFlow.Infrastructure.csproj" />
  </ItemGroup>

</Project>
