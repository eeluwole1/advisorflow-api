<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- HTTP surface: controllers, error mapping, composition root. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>3069aeac-353a-4b97-8ae0-fe43ead19830</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The API contract is served at /openapi/v1.yaml for Swagger UI in Development. -->
    <None Include="..\..\docs\api\openapi.v1.yaml" Link="openapi.v1.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <!-- Validates Microsoft Entra ID access tokens on create/update endpoints (ADR-015). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdvisorFlow.Application\AdvisorFlow.Application.csproj" />
    <ProjectReference Include="..\AdvisorFlow.Infrastructure\AdvisorFlow.Infrastructure.csproj" />
  </ItemGroup>

</Project>
