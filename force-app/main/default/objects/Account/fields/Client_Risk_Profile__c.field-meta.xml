<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Client_Risk_Profile__c</fullName>
    <description>Tracks a client&apos;s investment risk tolerance within AdvisorFlow CRM.</description>
    <inlineHelpText>Select Conservative for lower risk tolerance, Moderate for balanced risk tolerance, or Aggressive for higher risk tolerance.</inlineHelpText>
    <label>Client Risk Profile</label>
    <required>false</required>
    <trackFeedHistory>false</trackFeedHistory>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Conservative</fullName>
                <default>false</default>
                <label>Conservative</label>
            </value>
            <value>
                <fullName>Moderate</fullName>
                <default>false</default>
                <label>Moderate</label>
            </value>
            <value>
                <fullName>Aggressive</fullName>
                <default>false</default>
                <label>Aggressive</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
