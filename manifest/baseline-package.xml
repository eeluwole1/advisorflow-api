<?xml version="1.0" encoding="UTF-8"?>
<!--
  AdvisorFlow baseline: only the metadata this project owns or depends on.
  Members are listed explicitly (no * wildcards) so a retrieve does not pull every
  profile, layout and Salesforce-internal permission set in the org.
  Profiles are retrieved together with the objects so they carry field-level
  security for Account, Contact and Opportunity fields only.
  The AdvisorFlow API permission sets define the integration user's access (ADR-007, ADR-008).
  Run scripts/retrieve-baseline.sh (or .ps1). See docs/deployment/salesforce-baseline-runbook.md.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <types>
        <members>Account</members>
        <members>Contact</members>
        <members>Opportunity</members>
        <name>CustomObject</name>
    </types>
    <types>
        <members>Activity.Automation__c</members>
        <name>CustomField</name>
    </types>
    <types>
        <members>AdvisorFlow_Opportunity_Follow_Ups</members>
        <name>Flow</name>
    </types>
    <types>
        <members>Account-Account %28Marketing%29 Layout</members>
        <members>Account-Account %28Sales%29 Layout</members>
        <members>Account-Account %28Support%29 Layout</members>
        <members>Account-Account Layout</members>
        <members>Contact-Contact %28Marketing%29 Layout</members>
        <members>Contact-Contact %28Sales%29 Layout</members>
        <members>Contact-Contact %28Support%29 Layout</members>
        <members>Contact-Contact Layout</members>
        <members>Opportunity-Opportunity %28Marketing%29 Layout</members>
        <members>Opportunity-Opportunity %28Sales%29 Layout</members>
        <members>Opportunity-Opportunity %28Support%29 Layout</members>
        <members>Opportunity-Opportunity Layout</members>
        <name>Layout</name>
    </types>
    <types>
        <members>AdvisorFlow_API_Read</members>
        <members>AdvisorFlow_API_Write</members>
        <name>PermissionSet</name>
    </types>
    <types>
        <members>Admin</members>
        <members>Custom%3A Marketing Profile</members>
        <members>Custom%3A Sales Profile</members>
        <members>Custom%3A Support Profile</members>
        <members>MarketingProfile</members>
        <members>Read Only</members>
        <members>Standard</members>
        <name>Profile</name>
    </types>
    <types>
        <members>AccountType</members>
        <members>OpportunityStage</members>
        <name>StandardValueSet</name>
    </types>
    <version>68.0</version>
</Package>
